
# User Overrides-configuration
maillog_file = /var/log/mail/mail.log
myhostname = mail.b2bprosperity.com
myorigin = mail.b2bprosperity.com
mydestination = localhost, $myhostname
mynetworks = 127.0.0.0/8, 5.230.29.58, 77.90.32.0/24, 172.66.1.0/24, 172.17.0.0/16, 10.0.0.0/8, 185.215.180.87
inet_interfaces = all
default_process_limit = 60

# Virtual domain configuration
virtual_mailbox_domains = proxy:pgsql:/etc/postfix/sql/pgsql_virtual_domains_maps.cf
virtual_alias_maps = proxy:pgsql:/etc/postfix/sql/pgsql_virtual_alias_maps.cf, proxy:pgsql:/etc/postfix/sql/pgsql_virtual_alias_domain_catchall_maps.cf, proxy:pgsql:/etc/postfix/sql/pgsql_virtual_alias_domain_mailbox_maps.cf
virtual_mailbox_maps = proxy:pgsql:/etc/postfix/sql/pgsql_virtual_mailbox_maps.cf, proxy:pgsql:/etc/postfix/sql/pgsql_virtual_alias_domain_catchall_maps.cf
virtual_transport = lmtp:inet:127.0.0.1:26

# SMTPD restrictions - simple form
smtpd_relay_restrictions = permit_mynetworks, permit_sasl_authenticated, reject_unauth_destination
smtpd_recipient_restrictions = permit_mynetworks, permit_sasl_authenticated, reject_unauth_destination
smtpd_sender_restrictions = permit_mynetworks

# Header checks & Outbound Privacy
# Message size limit
message_size_limit = 104857600

# Local delivery
local_recipient_maps =

# Anti-brute force and throttling limits
smtpd_soft_error_limit = 3
smtpd_hard_error_limit = 5
smtpd_error_sleep_time = 2s
smtp_connect_timeout = 10s
smtp_helo_timeout = 10s

# Relay service
sender_dependent_relayhost_maps = hash:/etc/postfix/conf/sender_relay_maps_primary, proxy:pgsql:/etc/postfix/sql/pgsql_sender_relay_maps.cf
smtp_sasl_password_maps = hash:/etc/postfix/conf/sasl_passwd_primary, hash:/etc/postfix/conf/sasl_passwd
sender_dependent_default_transport_maps = proxy:pgsql:/etc/postfix/sql/pgsql_sender_transport_maps.cf
default_transport = smtp_safe_default

# Milter configuration (added 2026-08-30)
smtpd_milters = inet:127.0.0.1:11332
non_smtpd_milters = inet:127.0.0.1:11332
milter_mail_macros = i {mail_addr} {client_addr} {client_name} {auth_authen} {auth_author} {mail_addr} {mail_host}
milter_protocol = 6
milter_default_action = accept

# Inbound TLS configuration
smtpd_tls_cert_file = /etc/ssl/mail/mail.b2bprosperity.com/fullchain.pem
smtpd_tls_key_file = /etc/ssl/mail/mail.b2bprosperity.com/privkey.pem
smtpd_tls_security_level = may
tls_server_sni_maps = hash:/etc/postfix/conf/vmail_ssl.map

# Outbound TLS configuration (Modern TLS 1.2+ & System CA Verification)
smtp_tls_security_level = may
smtp_tls_protocols = >=TLSv1.2
smtp_tls_ciphers = medium
smtp_tls_CApath = /etc/ssl/certs
smtp_tls_loglevel = 1

# SASL configuration
smtpd_sasl_type = dovecot
smtpd_sasl_authenticated_header = no
smtpd_sasl_path = inet:127.0.0.1:10002
smtpd_sasl_auth_enable = no
inet_protocols = ipv4

# Queue management and bounce optimization
notify_classes = 2bounce
maximal_queue_lifetime = 1d
bounce_queue_lifetime = 1d
alias_maps = hash:/etc/aliases
alias_database = hash:/etc/aliases
mailbox_size_limit = 0
